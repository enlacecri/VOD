# Puertos locales aislados para VOD
VOD_POSTGRES_PORT=5434
VOD_REDIS_PORT=6380
VOD_NGINX_PORT=8085
VOD_API_PORT=8005

# Base de datos
DATABASE_URL=postgresql+psycopg://vod_user:vod_password@localhost:5434/vod_db

# Redis
REDIS_URL=redis://localhost:6380/0

# Storage
INGEST_ROOT=./storage/input
STAGING_ROOT=./storage/staging
OUTPUT_ROOT=./storage/output
PROCESSED_ROOT=./storage/processed

# HLS config
HLS_PLAYBACK_BASE_URL=http://localhost:8085
HLS_TIME=6

# Phase 2 Settings
FFPROBE_PATH=ffprobe
FFPROBE_TIMEOUT_SECONDS=15
MAX_FILE_SIZE_BYTES=53687091200
PROBE_JSON_LIMIT_BYTES=1048576
HASH_CHUNK_SIZE=65536

# RQ Settings
RQ_QUEUE_NAME=vod_tasks
RQ_JOB_TIMEOUT_SECONDS=3600
MAX_PROBE_ATTEMPTS=3
MAX_TRANSCODE_ATTEMPTS=3
ERROR_MESSAGE_MAX_LENGTH=1000
STAGING_ORPHAN_AGE_SECONDS=86400
MIN_FREE_DISK_BYTES=1073741824

# Required for dashboard data and administrative actions. Use a long random value.
ADMIN_API_KEY=

# Phase 3 Settings
FFMPEG_PATH=ffmpeg
FFMPEG_ENCODER_CHECK_TIMEOUT_SECONDS=10
FFMPEG_TIMEOUT_SECONDS=14400
FFMPEG_GRACEFUL_STOP_SECONDS=10
HLS_GOP_SECONDS=2
VIDEO_ENCODER=h264_videotoolbox
VIDEO_ENCODER_FALLBACK=libx264
TRANSCODE_CONCURRENCY=1

CDN_BASE_URL=https://videocdn.enlace.plus
HLS_VALIDATION_TIMEOUT_SECONDS=300

# Tolerances and Intervals
ASPECT_RATIO_TOLERANCE=0.05
BANDWIDTH_OVERHEAD_MAX_RATIO=1.3
HEARTBEAT_INTERVAL_SECONDS=5
PROGRESS_PERSIST_INTERVAL_SECONDS=5

# Phase 6 Settings (Smart Transcode Orchestrator)
TRANSCODE_ORCHESTRATOR_ENABLED=true
TRANSCODE_NODE_NAME=
TRANSCODE_MAX_CONCURRENT=1
TRANSCODE_RESERVED_PRIORITY_SLOTS=0
TRANSCODE_CPU_START_THRESHOLD=75
TRANSCODE_CPU_HARD_THRESHOLD=90
TRANSCODE_MIN_AVAILABLE_MEMORY_MB=2048
TRANSCODE_MIN_FREE_DISK_GB=20
TRANSCODE_SLOT_TTL_SECONDS=60
TRANSCODE_HEARTBEAT_INTERVAL_SECONDS=20
TRANSCODE_RETRY_MIN_SECONDS=5
TRANSCODE_RETRY_MAX_SECONDS=30
TRANSCODE_JOB_TIMEOUT_SECONDS=
